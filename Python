"""Emergency mode state machine."""

from __future__ import annotations

from dataclasses import dataclass, field
from enum import Enum
from typing import List, Optional

from dphone.emergency.power import PowerPolicy
from dphone.emergency.beacon import EmergencyBeacon, BeaconReason


class EmergencyMode(str, Enum):
    NORMAL = "NORMAL"
    RESILIENCE = "RESILIENCE"
    CRITICAL = "CRITICAL"

    def __str__(self) -> str:
        return self.value


@dataclass
class EmergencyEvent:
    kind: str
    reason: str
    mode_before: EmergencyMode
    mode_after: EmergencyMode
    detail: str = ""


class EmergencyController:
    def __init__(self, policy: Optional[PowerPolicy] = None,
                 beacon_interval_s: float = 30.0) -> None:
        self.policy = policy or PowerPolicy()
        self.beacon_interval_s = beacon_interval_s
        self.mode: EmergencyMode = EmergencyMode.NORMAL
        self.armed: bool = False
        self._t_since_beacon: float = 0.0
        self.beacons: List[EmergencyBeacon] = []
        self.events: List[EmergencyEvent] = []

    def arm(self) -> None:
        self.armed = True

    def disarm(self) -> None:
        self.armed = False
        self._transition_to(EmergencyMode.NORMAL, reason="disarm")

    def trigger(self, reason: str = "manual") -> None:
        if not self.armed:
            self.arm()
        if reason in ("battery_critical", "ap_offline"):
            self._transition_to(EmergencyMode.RESILIENCE, reason=reason)
        elif reason == "sos_button":
            self._transition_to(EmergencyMode.CRITICAL, reason=reason)
        else:
            self._transition_to(EmergencyMode.RESILIENCE, reason=reason)

    def _transition_to(self, mode: EmergencyMode, reason: str) -> None:
        if mode == self.mode:
            return
        before = self.mode
        self.mode = mode
        self.events.append(EmergencyEvent(
            kind="mode_change",
            reason=reason,
            mode_before=before,
            mode_after=mode,
        ))

    def tick(self, dt: float = 1.0,
             battery_pct: float = 100.0,
             soc_temp_c: float = 25.0,
             node_id: int = 0,
             lat: Optional[float] = None,
             lon: Optional[float] = None) -> Optional[EmergencyBeacon]:

        if self.mode == EmergencyMode.NORMAL and not self.policy.main_domain_allowed(
                battery_pct, soc_temp_c):
            self._transition_to(EmergencyMode.RESILIENCE, reason="power_policy")

        if (self.mode == EmergencyMode.RESILIENCE
                and battery_pct <= self.policy.beacon_floor * 100.0):
            self._transition_to(EmergencyMode.CRITICAL, reason="beacon_floor")

        if self.mode == EmergencyMode.NORMAL:
            return None

        self._t_since_beacon += dt
        if self._t_since_beacon < self.beacon_interval_s:
            return None
        self._t_since_beacon = 0.0

        reason = {
            EmergencyMode.RESILIENCE: BeaconReason.BATTERY_CRITICAL,
            EmergencyMode.CRITICAL: BeaconReason.SOS_BUTTON,
        }.get(self.mode, BeaconReason.MANUAL)

        beacon = EmergencyBeacon(
            node_id=node_id,
            reason=reason,
            battery_pct=battery_pct,
            last_known_lat=lat,
            last_known_lon=lon,
            temperature_c=soc_temp_c,
            seq=len(self.beacons),
        )
        self.beacons.append(beacon)
        return beacon

    @property
    def log(self) -> List[EmergencyEvent]:
        return list(self.events)

    def snapshot(self) -> dict:
        return {
            "mode": str(self.mode),
            "armed": self.armed,
            "beacons": len(self.beacons),
            "events": [
                {
                    "kind": e.kind,
                    "reason": e.reason,
                    "before": str(e.mode_before),
                    "after": str(e.mode_after),
                }
                for e in self.events
            ],
        }
