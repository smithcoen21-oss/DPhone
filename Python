        "watchdog_resets": float(watchdog_resets),
        "crc_errors": float(crc_errors),
        "dropped_packets": float(dropped_packets),
    }

    if battery_pct <= 10.0:
        report.issues.append("battery_critical")
    elif battery_pct <= 25.0:
        report.issues.append("battery_low")

    if soc_temp_c >= 75.0:
        report.issues.append("thermal_critical")
    elif soc_temp_c >= 55.0:
        report.issues.append("thermal_high")

    if watchdog_resets > 0:
        report.issues.append("watchdog_resets")
    if crc_errors > 10:
        report.issues.append("crc_errors_high")
    if dropped_packets > 50:
