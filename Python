"""Mesh topology graph with edge quality and partition detection."""

from __future__ import annotations

import random
from dataclasses import dataclass
from typing import Dict, List, Optional, Set, Tuple

from dphone.mesh.node import MeshNode, NodeRole


@dataclass
class Edge:
    a: str
    b: str
    quality: float = 1.0

    def other(self, node_id: str) -> str:
        if node_id == self.a:
            return self.b
        if node_id == self.b:
            return self.a
        raise KeyError(node_id)

    def key(self) -> Tuple[str, str]:
        return tuple(sorted((self.a, self.b)))


class Topology:
    def __init__(self) -> None:
        self._nodes: Dict[str, MeshNode] = {}
        self._edges: Dict[Tuple[str, str], Edge] = {}

    def add_node(self, node_id: str, roles: Optional[Set] = None,
                 **kw) -> MeshNode:
        if roles is None:
            roles = {NodeRole.USER}
        roles_typed = {r if isinstance(r, NodeRole) else NodeRole(r) for r in roles}
        node = MeshNode(node_id=node_id, roles=roles_typed, **kw)
        self._nodes[node_id] = node
        return node

    def add_edge(self, a: str, b: str, quality: float = 1.0) -> Edge:
        if a not in self._nodes or b not in self._nodes:
            raise KeyError("both endpoints must exist")
        if a == b:
            raise ValueError("self-edges not allowed")
        edge = Edge(a=min(a, b), b=max(a, b), quality=quality)
        self._edges[edge.key()] = edge
        self._nodes[a].neighbors.add(b)
        self._nodes[b].neighbors.add(a)
        return edge

    def remove_edge(self, a: str, b: str) -> None:
        key = tuple(sorted((a, b)))
        if key in self._edges:
            del self._edges[key]
            self._nodes[a].neighbors.discard(b)
            self._nodes[b].neighbors.discard(a)

    @property
    def nodes(self) -> Dict[str, MeshNode]:
        return dict(self._nodes)

    @property
    def edges(self) -> Dict[Tuple[str, str], Edge]:
        return dict(self._edges)

    def neighbors(self, node_id: str) -> List[str]:
        return sorted(self._nodes[node_id].neighbors)

    def edge_quality(self, a: str, b: str) -> float:
        key = tuple(sorted((a, b)))
        edge = self._edges.get(key)
        return edge.quality if edge else 0.0

    def reachable(self, src: str, dst: str) -> bool:
        return dst in self._bfs(src)

    def _bfs(self, src: str) -> Set[str]:
        if src not in self._nodes or not self._nodes[src].online:
            return set()
        seen: Set[str] = {src}
        frontier = [src]
        while frontier:
            nxt = []
            for n in frontier:
                for m in self._nodes[n].neighbors:
                    if m in seen:
                        continue
                    if not self._nodes[m].online:
                        continue
                    seen.add(m)
                    nxt.append(m)
            frontier = nxt
        return seen

    def partitions(self) -> List[Set[str]]:
        remaining = {nid for nid, n in self._nodes.items() if n.online}
        parts: List[Set[str]] = []
        while remaining:
            start = next(iter(remaining))
            comp = self._bfs(start)
            parts.append(comp)
            remaining -= comp
        return parts

    def partition(self, node_id: str) -> None:
        if node_id in self._nodes:
            self._nodes[node_id].go_offline()

    def heal(self, node_id: str) -> None:
        if node_id in self._nodes:
            self._nodes[node_id].go_online()

    @classmethod
    def demo(cls, n: int = 3, seed: int = 1) -> "Topology":
        rng = random.Random(seed)
        topo = cls()
        ids = [f"dphone-{i+1:02d}" for i in range(n)]
        for i, nid in enumerate(ids):
            roles = {NodeRole.USER}
            if i % 3 == 1:
                roles.add(NodeRole.RELAY)
            if i == n - 1:
                roles.add(NodeRole.BEACON)
            topo.add_node(nid, roles=roles)

        for i in range(n - 1):
            q = 0.5 + 0.5 * rng.random()
            topo.add_edge(ids[i], ids[i + 1], quality=q)

        extra = max(0, n // 2)
        for _ in range(extra):
            a, b = rng.sample(ids, 2)
            if a == b or tuple(sorted((a, b))) in topo._edges:
                continue
            topo.add_edge(a, b, quality=0.4 + 0.6 * rng.random())

        return topo
