"""Tests for the DPhoneVision packet protocol."""

import pytest

from dphone.protocol import (
    Packet, Opcode, encode, decode, PacketParser, CRCError, FrameError,
)
from dphone.protocol.codec import crc16_ccitt


def test_crc16_ccitt_known_vector():
    assert crc16_ccitt(b"123456789") == 0x29B1


def test_packet_roundtrip():
    pkt = Packet(opcode=Opcode.LINK_STATUS, seq=1, src=0x01, dst=0x02,
                 payload=b"\x00\x01")
    raw = encode(pkt)
    assert decode(raw) == pkt


def test_packet_roundtrip_empty_payload():
    pkt = Packet(opcode=Opcode.PING, seq=0, src=0xAA, dst=0xBB)
    assert decode(encode(pkt)) == pkt


def test_packet_rejects_bad_seq():
    with pytest.raises(ValueError):
        Packet(opcode=Opcode.PING, seq=999)


def test_packet_rejects_bad_payload_type():
    with pytest.raises(TypeError):
        Packet(opcode=Opcode.PING, payload="not-bytes")


def test_decode_crc_error():
    pkt = Packet(opcode=Opcode.PING, seq=0, src=1, dst=2, payload=b"hello")
    raw = bytearray(encode(pkt))
    raw[-1] ^= 0xFF
    with pytest.raises(CRCError):
        decode(bytes(raw))


def test_decode_bad_sync():
    with pytest.raises(FrameError):
        decode(b"\x00\x00" + b"\x00" * 20)


def test_decode_too_short():
    with pytest.raises(FrameError):
        decode(b"\xD0\x50\x00")


def test_decode_unknown_opcode():
    pkt = Packet(opcode=Opcode.PING, seq=0, src=1, dst=2, payload=b"")
    raw = bytearray(encode(pkt))
    raw[2] = 0xEE
    body = bytes(raw[2:-2])
    new_crc = crc16_ccitt(body).to_bytes(2, "big")
    raw[-2:] = new_crc
    with pytest.raises(FrameError):
        decode(bytes(raw))


def test_parser_incremental():
    pkt1 = Packet(opcode=Opcode.PING, seq=1, src=1, dst=2)
    pkt2 = Packet(opcode=Opcode.PONG, seq=2, src=2, dst=1)
    stream = encode(pkt1) + encode(pkt2)

    parser = PacketParser()
    out = []
    for b in stream:
        out.extend(parser.feed(bytes([b])))
    assert out == [pkt1, pkt2]


def test_parser_handles_garbage_prefix():
    pkt = Packet(opcode=Opcode.PING, seq=1, src=1, dst=2)
    stream = b"\xAA\xBB\xCC" + encode(pkt)
    parser = PacketParser()
    out = list(parser.feed(stream))
    assert out == [pkt]


def test_parser_counts_crc_errors():
    pkt = Packet(opcode=Opcode.PING, seq=1, src=1, dst=2, payload=b"x")
    raw = bytearray(encode(pkt))
    raw[-1] ^= 0xFF
    parser = PacketParser()
    list(parser.feed(bytes(raw)))
    assert parser.crc_errors == 1


def test_packet_to_from_dict_roundtrip():
    pkt = Packet(opcode=Opcode.EMERGENCY_BEACON, seq=7, src=3, dst=0xFF,
                 payload=b"\x01\x02\x03")
    assert Packet.from_dict(pkt.to_dict()) == pkt


def test_broadcast_flag():
