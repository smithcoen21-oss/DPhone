"""Opcode table for the DPhoneVision packet protocol."""

from __future__ import annotations

from enum import IntEnum


class Opcode(IntEnum):
    """Wire opcodes. Grouped by functional range."""

    # 0x00–0x1F — System / control
    NOP = 0x00
    RESET = 0x01
    WAKE = 0x02
    STATUS = 0x03
    VERSION = 0x04
    PING = 0x05
    PONG = 0x06

    # 0x20–0x3F — Link management
    LINK_PROBE = 0x20
    LINK_QUALITY = 0x21
    LINK_SELECT = 0x22
    LINK_FAILOVER = 0x23
    LINK_STATUS = 0x24

    # 0x40–0x5F — Mesh
    ROUTE_REQUEST = 0x40
    ROUTE_REPLY = 0x41
    ROUTE_FORWARD = 0x42
    ROUTE_ERROR = 0x43
    MESH_JOIN = 0x44
    MESH_LEAVE = 0x45

    # 0x60–0x7F — Emergency
    EMERGENCY_SOS = 0x60
    EMERGENCY_BEACON = 0x61
    EMERGENCY_ACK = 0x62
    EMERGENCY_CLEAR = 0x63

    # 0x80–0x9F — Telemetry
    SENSOR_SAMPLE = 0x80
    HEALTH_REPORT = 0x81
    POWER_REPORT = 0x82
    THERMAL_REPORT = 0x83

    # 0xA0–0xBF — Diagnostics
    DIAG_REQUEST = 0xA0
    DIAG_RESPONSE = 0xA1
    LOG_CHUNK = 0xA2
    CRC_ERROR_REPORT = 0xA3

    # 0xC0–0xFF — Reserved
