cat > "$ROOT/dphone/protocol/packet.py" <<'EOF'
"""Packet model for the DPhoneVision protocol."""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Optional

from dphone.protocol.opcodes import Opcode

SYNC_BYTES: bytes = b"\xD0\x50"   # "DP"
HEADER_SIZE: int = 2 + 1 + 1 + 1 + 1 + 2   # sync + opcode + seq + src + dst + len
CRC_SIZE: int = 2
MIN_FRAME_SIZE: int = HEADER_SIZE + CRC_SIZE

BROADCAST_ADDR: int = 0xFF


@dataclass(frozen=True)
class Packet:
    """A single DPhoneVision protocol frame."""

    opcode: Opcode
    seq: int = 0
    src: int = 0
    dst: int = BROADCAST_ADDR
    payload: bytes = field(default=b"")

    def __post_init__(self) -> None:
        if not isinstance(self.opcode, Opcode):
            object.__setattr__(self, "opcode", Opcode(int(self.opcode)))
        for name in ("seq", "src", "dst"):
            v = getattr(self, name)
            if not (0 <= v <= 0xFF):
                raise ValueError(f"{name} must be 0..255, got {v}")
        if not isinstance(self.payload, (bytes, bytearray)):
            raise TypeError("payload must be bytes")
        if len(self.payload) > 0xFFFF:
            raise ValueError("payload too large (max 65535 bytes)")
        if not isinstance(self.payload, bytes):
            object.__setattr__(self, "payload", bytes(self.payload))

    @property
    def payload_len(self) -> int:
        return len(self.payload)

    def is_broadcast(self) -> bool:
        return self.dst == BROADCAST_ADDR

    def with_seq(self, seq: int) -> "Packet":
        return Packet(opcode=self.opcode, seq=seq & 0xFF,
                      src=self.src, dst=self.dst, payload=self.payload)

    def to_dict(self) -> dict:
        return {
            "opcode": int(self.opcode),
            "opcode_name": self.opcode.name,
            "seq": self.seq,
            "src": self.src,
            "dst": self.dst,
            "payload": self.payload.hex(),
        }

    @classmethod
    def from_dict(cls, d: dict) -> "Packet":
        return cls(
            opcode=Opcode(d["opcode"]),
            seq=d["seq"],
            src=d["src"],
            dst=d["dst"],
            payload=bytes.fromhex(d["payload"]),
        )

    def __repr__(self) -> str:
        return (f"Packet(op={self.opcode.name}, seq={self.seq}, "
                f"src=0x{self.src:02X}, dst=0x{self.dst:02X}, "
                f"len={self.payload_len})")
EOF

cat > "$ROOT/dphone/protocol/codec.py" <<'EOF'
"""Wire codec for the DPhoneVision protocol.

Frame layout:

    +--------+--------+--------+--------+--------+---------+--------+
    | SYNC   | OPCODE | SEQ    | SRC    | DST    | LEN     | PAYLOAD| CRC16 |
    | 2 B    | 1 B    | 1 B    | 1 B    | 1 B    | 2 B     | LEN B  | 2 B   |
    +--------+--------+--------+--------+--------+---------+--------+

CRC is CRC-16/CCITT-FALSE (poly 0x1021, init 0xFFFF) over
opcode..payload (i.e. everything after sync, before CRC).
"""

from __future__ import annotations

import struct
from typing import Iterator, Optional

from dphone.protocol.opcodes import Opcode
from dphone.protocol.packet import (
    Packet, SYNC_BYTES, HEADER_SIZE, CRC_SIZE, MIN_FRAME_SIZE,
)


class FrameError(ValueError):
    """Raised when a frame cannot be parsed."""


class CRCError(FrameError):
    """Raised when the CRC does not match."""


def crc16_ccitt(data: bytes, init: int = 0xFFFF) -> int:
    """CRC-16/CCITT-FALSE."""
    crc = init & 0xFFFF
    for b in data:
        crc ^= (b & 0xFF) << 8
        for _ in range(8):
            if crc & 0x8000:
                crc = ((crc << 1) ^ 0x1021) & 0xFFFF
            else:
                crc = (crc << 1) & 0xFFFF
    return crc


def encode(packet: Packet) -> bytes:
    """Serialize a Packet into wire bytes."""
    if not isinstance(packet, Packet):
        raise TypeError("encode() expects a Packet")

    header = struct.pack(
        ">BBBBBH",
        int(packet.opcode),
        packet.seq & 0xFF,
        packet.src & 0xFF,
        packet.dst & 0xFF,
        (packet.payload_len >> 8) & 0xFF,
        packet.payload_len & 0xFF,
    )
    body = header + packet.payload
    crc = crc16_ccitt(body)
    return SYNC_BYTES + body + struct.pack(">H", crc)


def decode(frame: bytes) -> Packet:
    """Deserialize a single complete frame into a Packet."""
    if len(frame) < MIN_FRAME_SIZE:
        raise FrameError(f"frame too short: {len(frame)} < {MIN_FRAME_SIZE}")
    if frame[:2] != SYNC_BYTES:
        raise FrameError("bad sync bytes")

    body = frame[2:-CRC_SIZE]
    crc_recv = struct.unpack(">H", frame[-CRC_SIZE:])[0]
    crc_calc = crc16_ccitt(body)
    if crc_recv != crc_calc:
        raise CRCError(f"CRC mismatch: recv=0x{crc_recv:04X} calc=0x{crc_calc:04X}")

    opcode_raw, seq, src, dst, len_hi, len_lo = struct.unpack(">BBBBBH", body[:HEADER_SIZE])
    payload_len = (len_hi << 8) | len_lo
    payload = body[HEADER_SIZE:]

    if len(payload) != payload_len:
        raise FrameError(f"payload length mismatch: header={payload_len} actual={len(payload)}")
    if not Opcode.is_known(opcode_raw):
        raise FrameError(f"unknown opcode: 0x{opcode_raw:02X}")

    return Packet(
        opcode=Opcode(opcode_raw),
        seq=seq,
        src=src,
        dst=dst,
        payload=payload,
    )


class PacketParser:
    """Incremental byte-stream parser.

    Feed bytes one at a time (or in chunks) and receive complete Packets.
    Resynchronizes on sync-byte loss. Drops frames with bad CRC and
    optionally reports them.
    """

    def __init__(self) -> None:
        self._buf = bytearray()
        self.crc_errors = 0
        self.frame_errors = 0

    def reset(self) -> None:
        self._buf.clear()

    def feed(self, chunk: bytes) -> Iterator[Packet]:
        if not isinstance(chunk, (bytes, bytearray)):
            raise TypeError("feed() expects bytes")
        self._buf.extend(chunk)

        while True:
            idx = self._buf.find(SYNC_BYTES)
            if idx < 0:
                if len(self._buf) > 1:
                    del self._buf[:-1]
                return
            if idx > 0:
                del self._buf[:idx]

            if len(self._buf) < HEADER_SIZE + 2:
                return

            len_hi = self._buf[6]
            len_lo = self._buf[7]
            payload_len = (len_hi << 8) | len_lo
            frame_len = HEADER_SIZE + payload_len + CRC_SIZE

            if len(self._buf) < frame_len:
                return

            frame = bytes(self._buf[:frame_len])
            try:
                pkt = decode(frame)
                yield pkt
            except CRCError:
                self.crc_errors += 1
            except FrameError:
                self.frame_errors += 1

            del self._buf[:frame_len]
EOF

