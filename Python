        for i, nid in enumerate(sorted(self.topo.nodes)):
            lm = LinkManager(node_id=i + 1)
            for lt in self.channels:
                lm.register(lt, quality=self.channels[lt].quality(0))
            lm.evaluate()
            self.managers[nid] = lm
            self.telemetry[nid] = DeviceTelemetry(node_id=i + 1)
            self.emergency[nid] = EmergencyController(
                policy=PowerPolicy(), beacon_interval_s=5.0)
            self.emergency[nid].arm()
            self.telemetry[nid].record_value("battery_pct", 100.0 - i * 5.0)
            self.telemetry[nid].record_value("temp_c", 30.0 + i)

    def step(self, step_index: int) -> None:
        pass

    def run(self, steps: int = 20) -> Iterator[Dict[str, dict]]:
        for i in range(steps):
            self.step(i)
            yield self._snapshot(i)

    def _snapshot(self, step_index: int) -> Dict[str, dict]:
        snap: Dict[str, dict] = {}
        for nid, lm in self.managers.items():
            if not self.topo.nodes[nid].online:
                continue

            for lt, ch in self.channels.items():
                q = ch.quality(step_index, distance_m=10.0 + self.rng.random() * 20)
                lm.update(lt, quality=q)
            lm.evaluate()

            t = self.telemetry[nid]
            d = t.as_dict()
            batt = max(0.0, float(d.get("battery_pct", 100.0)) - 0.5)
            temp = float(d.get("temp_c", 30.0)) + self.rng.uniform(-0.5, 0.5)
            t.record_value("battery_pct", batt)
            t.record_value("temp_c", temp)

            beacon = self.emergency[nid].tick(
                dt=1.0, battery_pct=batt, soc_temp_c=temp,
                node_id=lm.node_id,
            )
            events: List[str] = []
            if beacon is not None:
                events.append(f"beacon reason={beacon.reason} seq={beacon.seq}")

            active = lm.active
            row = {
                "link": str(active) if active else "-",
                "state": str(lm.state),
                "quality": lm.links()[active].quality.score() if active else 0.0,
                "peers": len(self.topo.neighbors(nid)),
                "route": self.router.route(nid, sorted(self.topo.nodes)[0]) or [],
                "events": events,
            }
            snap[nid] = row
        return snap


class BasicScenario(Scenario):
    name = "basic"


class MeshPartitionScenario(Scenario):
    name = "mesh-partition"

    def step(self, step_index: int) -> None:
        if step_index == 4 and self.nodes >= 4:
            victim = sorted(self.topo.nodes)[3]
            self.topo.partition(victim)
            self.router.on_node_lost(victim)
        if step_index == 8 and self.nodes >= 4:
            victim = sorted(self.topo.nodes)[3]
            self.topo.heal(victim)
            self.router.on_node_joined(victim)


class EmergencyDrillScenario(Scenario):
    name = "emergency-drill"

    def step(self, step_index: int) -> None:
        if step_index == 3:
            for nid in sorted(self.topo.nodes)[:1]:
                self.emergency[nid].trigger(reason="ap_offline")
        if step_index == 10:
            for nid in sorted(self.topo.nodes)[:1]:
                self.emergency[nid].trigger(reason="sos_button")


class SeismicFadeScenario(Scenario):
    name = "seismic-fade"

    def step(self, step_index: int) -> None:
        if step_index == 5:
            for lm in self.managers.values():
                if LinkType.SEISMIC in lm.links():
                    lm.update(LinkType.SEISMIC, quality=0.05)


class BatteryCriticalScenario(Scenario):
    name = "battery-critical"

    def step(self, step_index: int) -> None:
        for nid in sorted(self.topo.nodes)[:1]:
            t = self.telemetry[nid]
            t.record_value("battery_pct", max(0.0, 12.0 - step_index))


SCENARIOS: Dict[str, Type[Scenario]] = {
    "basic": BasicScenario,
    "mesh-partition": MeshPartitionScenario,
    "emergency-drill": EmergencyDrillScenario,
    "seismic-fade": SeismicFadeScenario,
    "battery-critical": BatteryCriticalScenario,
}
