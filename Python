"""Abstract channel models for the four DPhone link types.

These are NOT physical models — they produce plausible quality/throughput
numbers so the control plane can be exercised.
"""

from __future__ import annotations

import math
import random


class ChannelModel:
    def __init__(self, rng: random.Random, base: float = 0.7,
                 noise: float = 0.1, distance_penalty: float = 0.02) -> None:
        self.rng = rng
        self.base = base
        self.noise = noise
        self.distance_penalty = distance_penalty

    def quality(self, step: int, distance_m: float = 10.0) -> float:
        drift = self.noise * math.sin(step / 5.0 + self.rng.random())
        jitter = self.rng.uniform(-self.noise, self.noise)
        q = self.base + drift + jitter - self.distance_penalty * distance_m / 10.0
        return _clamp01(q)


class SeismicChannel(ChannelModel):
    def __init__(self, rng): super().__init__(rng, base=0.55, noise=0.15,
                                             distance_penalty=0.05)


class MagneticChannel(ChannelModel):
    def __init__(self, rng): super().__init__(rng, base=0.45, noise=0.20,
                                             distance_penalty=0.08)


class AcousticChannel(ChannelModel):
    def __init__(self, rng): super().__init__(rng, base=0.65, noise=0.10,
                                             distance_penalty=0.03)


class MeshChannel(ChannelModel):
    def __init__(self, rng): super().__init__(rng, base=0.85, noise=0.08,
                                             distance_penalty=0.01)


def _clamp01(x: float) -> float:
    return 0.0 if x < 0.0 else 1.0 if x > 1.0 else x
