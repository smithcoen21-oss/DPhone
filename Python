"""Link-quality metric and scoring."""

from __future__ import annotations

from dataclasses import dataclass


@dataclass
class LinkQuality:
    """Normalized quality metric for a single link."""

    signal: float = 0.0
    throughput: float = 0.0
    latency: float = 1.0
    power_cost: float = 0.0
    security: float = 1.0

    W_SIGNAL: float = 0.35
    W_THROUGHPUT: float = 0.20
    W_LATENCY: float = 0.15
    W_POWER: float = 0.15
    W_SECURITY: float = 0.15

    def score(self) -> float:
        s = (
            self.W_SIGNAL * _clamp01(self.signal)
            + self.W_THROUGHPUT * _clamp01(self.throughput)
            + self.W_LATENCY * _clamp01(self.latency)
            + self.W_POWER * (1.0 - _clamp01(self.power_cost))
            + self.W_SECURITY * _clamp01(self.security)
        )
        return _clamp01(s)

    def state(self, connect_threshold: float = 0.6,
              degrade_threshold: float = 0.3) -> str:
        s = self.score()
        if s >= connect_threshold:
            return "CONNECTED"
        if s >= degrade_threshold:
            return "DEGRADED"
        return "FAILED"


def _clamp01(x: float) -> float:
    if x < 0.0:
        return 0.0
    if x > 1.0:
        return 1.0
    return float(x)
EOF

cat > "$ROOT/dphone/link/link_manager.py" <<'EOF'
"""Link Manager — evaluates physical links, picks the best, handles failover."""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Dict, List, Optional

from dphone.link.link_types import LinkType, LinkState
from dphone.link.quality import LinkQuality


@dataclass
class LinkEntry:
    link_type: LinkType
    quality: LinkQuality
    state: LinkState = LinkState.DISCONNECTED
    failovers: int = 0


@dataclass
class LinkEvent:
    kind: str
    link: LinkType
    old_state: LinkState
    new_state: LinkState
    reason: str = ""


class LinkManager:
    def __init__(self,
                 node_id: int,
                 connect_threshold: float = 0.6,
                 degrade_threshold: float = 0.3) -> None:
        self.node_id = node_id
        self.connect_threshold = connect_threshold
        self.degrade_threshold = degrade_threshold
        self._links: Dict[LinkType, LinkEntry] = {}
        self._active: Optional[LinkType] = None
        self.events: List[LinkEvent] = []

    def register(self, link_type: LinkType, quality: float = 0.0,
                 **quality_fields) -> LinkEntry:
        lq = LinkQuality(signal=quality, **quality_fields)
        entry = LinkEntry(link_type=link_type, quality=lq)
        self._links[link_type] = entry
        self._recompute_state(entry, reason="register")
        return entry

    def unregister(self, link_type: LinkType) -> None:
        self._links.pop(link_type, None)
        if self._active == link_type:
            self._active = None
            self.evaluate()

    def update(self, link_type: LinkType, quality: float = None,
               **quality_fields) -> None:
        entry = self._links.get(link_type)
        if entry is None:
            raise KeyError(f"link not registered: {link_type}")
        if quality is not None:
            entry.quality.signal = float(quality)
        for k, v in quality_fields.items():
            if not hasattr(entry.quality, k):
                raise AttributeError(f"unknown quality field: {k}")
            setattr(entry.quality, k, float(v))
        self._recompute_state(entry, reason="update")

    def _recompute_state(self, entry: LinkEntry, reason: str) -> None:
        old = entry.state
        name = entry.quality.state(
            connect_threshold=self.connect_threshold,
            degrade_threshold=self.degrade_threshold,
        )
        if entry.quality.score() <= 0.0:
            new = LinkState.DISCONNECTED
        else:
            new = LinkState(name)
        if new != old:
            entry.state = new
            self.events.append(LinkEvent(
                kind="state_change", link=entry.link_type,
                old_state=old, new_state=new, reason=reason,
            ))

    def best_link(self) -> Optional[LinkType]:
        connected = [e for e in self._links.values() if e.state == LinkState.CONNECTED]
        if connected:
            return max(connected, key=lambda e: e.quality.score()).link_type
        degraded = [e for e in self._links.values() if e.state == LinkState.DEGRADED]
        if degraded:
            return max(degraded, key=lambda e: e.quality.score()).link_type
        return None

    def evaluate(self) -> Optional[LinkType]:
        chosen = self.best_link()
        if chosen != self._active:
            old = self._active
            self._active = chosen
            if chosen is not None:
                self._links[chosen].failovers += 1
            self.events.append(LinkEvent(
                kind="failover",
                link=chosen if chosen else LinkType.MESH,
