"""Command-line simulator for DPhoneVision."""

from __future__ import annotations

import argparse
import json
import sys
from typing import List

from dphone.sim import Scenario, SCENARIOS


def _print_header() -> None:
    print(f"{'step':<4}  {'node':<11}  {'link':<10}  {'state':<10}  "
          f"{'quality':<7}  {'peers':<5}  route")
    print("-" * 4 + "  " + "-" * 11 + "  " + "-" * 10 + "  " +
          "-" * 10 + "  " + "-" * 7 + "  " + "-" * 5 + "  " + "-" * 20)


def _run(args: argparse.Namespace) -> int:
    scenario_cls = SCENARIOS.get(args.scenario)
    if scenario_cls is None:
        print(f"unknown scenario: {args.scenario}", file=sys.stderr)
        print(f"available: {', '.join(sorted(SCENARIOS))}", file=sys.stderr)
        return 2

    scenario: Scenario = scenario_cls(nodes=args.nodes, seed=args.seed)

    if args.json:
        return _run_json(scenario, steps=args.steps)

    _print_header()
    for step, snapshot in enumerate(scenario.run(steps=args.steps)):
        for node_id, row in snapshot.items():
            route = ",".join(row.get("route", [])) or "-"
            print(f"{step:<4}  {node_id:<11}  {row['link']:<10}  "
                  f"{row['state']:<10}  {row['quality']:<7.2f}  "
                  f"{row['peers']:<5}  {route}")
            if args.verbose:
                for event in row.get("events", []):
                    print(f"      [event] {event}")
        print()

    return 0


def _run_json(scenario: Scenario, steps: int) -> int:
    out = {"scenario": scenario.name, "steps": []}
    for step, snapshot in enumerate(scenario.run(steps=steps)):
        out["steps"].append({"step": step, "nodes": snapshot})
    json.dump(out, sys.stdout, indent=2, default=str)
    sys.stdout.write("\n")
    return 0


def build_parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="dphone-sim",
        description="DPhoneVision multi-node link/mesh/emergency simulator.",
    )
    p.add_argument("--nodes", type=int, default=3,
                   help="Number of simulated DPhone nodes (default: 3)")
    p.add_argument("--scenario", type=str, default="basic",
                   choices=sorted(SCENARIOS.keys()),
                   help="Simulation scenario (default: basic)")
    p.add_argument("--steps", type=int, default=20,
                   help="Simulation steps to run (default: 20)")
    p.add_argument("--seed", type=int, default=1,
                   help="RNG seed for reproducible runs (default: 1)")
    p.add_argument("--json", action="store_true",
                   help="Emit machine-readable JSON instead of tables")
    p.add_argument("--verbose", action="store_true",
                   help="Print per-step link state transitions")
    return p


def main(argv: List[str] | None = None) -> int:
    parser = build_parser()
    args = parser.parse_args(argv)
    return _run(args)


if __name__ == "__main__":
    raise SystemExit(main())
EOF

