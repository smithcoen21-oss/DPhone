"""Self-healing mesh router."""

from __future__ import annotations

import heapq
from typing import Dict, List, Optional

from dphone.mesh.topology import Topology


class Router:
    def __init__(self, topology: Topology) -> None:
        self.topo = topology
        self._routes: Dict[str, Dict[str, List[str]]] = {}
        self.recompute()

    def recompute(self) -> None:
        self._routes.clear()
        for src, node in self.topo.nodes.items():
            if not node.online:
                continue
            self._routes[src] = self._dijkstra(src)

    def _dijkstra(self, src: str) -> Dict[str, List[str]]:
        dist: Dict[str, float] = {src: 0.0}
        prev: Dict[str, Optional[str]] = {src: None}
        pq = [(0.0, src)]
        while pq:
            d, u = heapq.heappop(pq)
            if d > dist.get(u, float("inf")):
                continue
            for v in self.topo.neighbors(u):
                if not self.topo.nodes[v].online:
                    continue
                q = max(1e-3, self.topo.edge_quality(u, v))
                w = 1.0 / q
                nd = d + w
                if nd < dist.get(v, float("inf")):
                    dist[v] = nd
                    prev[v] = u
                    heapq.heappush(pq, (nd, v))

        paths: Dict[str, List[str]] = {}
        for dst in dist:
            if dst == src:
                continue
            path = []
            cur: Optional[str] = dst
            while cur is not None:
                path.append(cur)
                cur = prev[cur]
            path.reverse()
            paths[dst] = path
        return paths

    def route(self, src: str, dst: str) -> Optional[List[str]]:
        if src == dst:
            return [src]
        return self._routes.get(src, {}).get(dst)

    def reachable(self, src: str, dst: str) -> bool:
        return self.route(src, dst) is not None

    def hops(self, src: str, dst: str) -> int:
        path = self.route(src, dst)
        return len(path) - 1 if path else -1

    def all_routes_from(self, src: str) -> Dict[str, List[str]]:
        return dict(self._routes.get(src, {}))

    def on_node_lost(self, node_id: str) -> None:
        self.topo.partition(node_id)
        self.recompute()

    def on_node_joined(self, node_id: str) -> None:
        self.topo.heal(node_id)
        self.recompute()
